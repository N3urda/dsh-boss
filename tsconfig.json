{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "lib": ["ES2023", "DOM", "ESNext.Decorators"],
    "types": ["node", "react"],
    "noEmit": true
  },
  "include": ["src", "tests"]
}
