{
  "name": "dsh-boss",
  "version": "0.2.4",
  "description": "DSH 个人求职工作台：机会、跟进与个人资料",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.13.0",
    "dsh": "0.2.1-rc.2"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "docs",
    "scripts/*.mjs",
    "scripts/*.py",
    "scripts/*.txt"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "prepack": "npm run build",
    "format": "prettier --write src tests scripts",
    "format:check": "prettier --check src tests scripts",
    "boss:setup": "node scripts/runtime.mjs setup",
    "boss:login": "node scripts/runtime.mjs login",
    "start": "node scripts/runtime.mjs start"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "coordtransform": "2.1.2",
    "leaflet": "1.9.4",
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-home-paths": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-api-gateway": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-registry": "0.2.1-rc.2",
    "@types/leaflet": "1.9.21",
    "@types/node": "^25.0.0",
    "@types/react": "^18.3.0",
    "esbuild": "0.28.2",
    "prettier": "3.6.2",
    "react": "18.3.1",
    "tsx": "^4.20.6",
    "typescript": "5.9.3"
  }
}
